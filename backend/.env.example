# ══════════════════════════════════════════════════════
# CENTRAL Backend — Variables de entorno
# Copia este archivo como .env y completa los valores
# ══════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────
PORT=3000
APP_URL=https://central-backend-production.up.railway.app

# ── Base de datos (Railway PostgreSQL) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# ── Tenant por defecto (seed al iniciar) ─────────────
DEFAULT_TENANT_EMAIL=tu@email.com
DEFAULT_TENANT_PASSWORD=tu_password_seguro

# ── Panel de administración ───────────────────────────
ADMIN_EMAIL=admin@central.app
ADMIN_PASSWORD=admin_password_seguro

# ── Demos para prospectos ─────────────────────────────
# Segunda clave, distinta de ADMIN_PASSWORD, que pide el panel para crear/extender demos.
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(30).toString('base64url'))"
DEMO_CREATION_KEY=

# ── WhatsApp Business API ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_TOKEN=tu_whatsapp_token
WEBHOOK_VERIFY_TOKEN=central_webhook_secreto_123

# ── Instagram Graph API ───────────────────────────────
INSTAGRAM_ACCESS_TOKEN=tu_instagram_token
INSTAGRAM_ACCOUNT_ID=tu_instagram_account_id

# ── Email (Resend) ────────────────────────────────────
# Crea cuenta en resend.com, verifica tu dominio y configura:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Formato: "Nombre <email@tudominio.com>"
# IMPORTANTE: debe ser un dominio verificado en Resend (no usar onboarding@resend.dev en prod)
RESEND_FROM=CENTRAL <no-reply@tudominio.com>

# ── Stripe (Billing) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxxxx

# ── Puppeteer (generación de tickets PDF) ────────────
# Railway lo detecta automáticamente via nixpacks.toml
# Solo necesario si Puppeteer no encuentra Chromium:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
