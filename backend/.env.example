# ══════════════════════════════════════════════════════
# CENTRAL Backend — Variables de entorno
# Copia este archivo como .env y completa los valores
# ══════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────
PORT=3000
APP_URL=https://central-backend-production.up.railway.app
# Modo producción: con NODE_ENV=production o RAILWAY_ENVIRONMENT (Railway lo pone solo)
# el servidor no arranca sin JWT_SECRET y el webhook rechaza todo sin META_APP_SECRET.
# NODE_ENV=production

# ── Base de datos (Railway PostgreSQL) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Conexiones máximas del pool por réplica (por defecto 10). IMPORTANTE: PG_POOL_MAX × número de réplicas (más PG_REPORT_POOL_MAX × réplicas)
# debe caber en el max_connections de Postgres. Los informes pesados se limitan a 2 a la vez por réplica y usan su propio pool.
PG_POOL_MAX=10
# Pool aparte de los informes (por defecto 3, statement_timeout de 20 s)
# PG_REPORT_POOL_MAX=3
# Espera máxima de un informe en cola, en ms (por defecto 30000; pasado el tiempo responde 503 busy)
# REPORT_WAIT_MS=30000
# Cada cuánto el servidor revalida las sesiones de los WebSocket abiertos, en ms (por defecto 180000)
# WS_REVALIDATE_MS=180000

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# ── Tenant por defecto (seed al iniciar) ─────────────
DEFAULT_TENANT_EMAIL=tu@email.com
DEFAULT_TENANT_PASSWORD=tu_password_seguro

# ── Panel de administración ───────────────────────────
ADMIN_EMAIL=admin@central.app
ADMIN_PASSWORD=admin_password_seguro

# ── Demos para prospectos ─────────────────────────────
# Segunda clave, distinta de ADMIN_PASSWORD, que pide el panel para crear/extender demos.
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(30).toString('base64url'))"
DEMO_CREATION_KEY=

# ── WhatsApp Business API ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_TOKEN=tu_whatsapp_token
WEBHOOK_VERIFY_TOKEN=cambia_esto_por_un_token_aleatorio
# Clave secreta de la app de Meta (Configuración → Básica). OBLIGATORIA en producción:
# sin ella el webhook rechaza todos los mensajes de WhatsApp e Instagram.
META_APP_SECRET=tu_meta_app_secret
# Opcional: solo si Instagram usa una app de Meta distinta
INSTAGRAM_APP_SECRET=

# ── Instagram Graph API ───────────────────────────────
INSTAGRAM_ACCESS_TOKEN=tu_instagram_token
INSTAGRAM_ACCOUNT_ID=tu_instagram_account_id

# ── Email (Resend) ────────────────────────────────────
# Crea cuenta en resend.com, verifica tu dominio y configura:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Formato: "Nombre <email@tudominio.com>"
# IMPORTANTE: debe ser un dominio verificado en Resend (no usar onboarding@resend.dev en prod)
RESEND_FROM=CENTRAL <no-reply@tudominio.com>

# ── Stripe (Billing) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxxxx

# ── Puppeteer (generación de tickets PDF) ────────────
# Railway lo detecta automáticamente via nixpacks.toml
# Solo necesario si Puppeteer no encuentra Chromium:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
